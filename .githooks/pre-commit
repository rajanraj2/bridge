#!/usr/bin/env bash
set -euo pipefail

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
if [ "$CURRENT_BRANCH" = "main" ]; then
    echo "❌ ERROR: Direct commits to the 'main' branch are strictly forbidden."
    echo "Please switch to a feature branch to make changes:"
    echo "   git checkout -b feature/<feature-name>"
    exit 1
fi
